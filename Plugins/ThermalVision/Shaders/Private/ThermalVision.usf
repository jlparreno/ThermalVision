#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Private/SceneTexturesCommon.ush"
#include "/Engine/Private/GammaCorrectionCommon.ush"

// Tonemapped scene color from the previous post-process pass (output resolution).
Texture2D InputTexture;
SamplerState InputSampler;

// Declares Input_Extent, Input_UVViewportMin, Input_UVViewportSizeInverse, ...
// Describes the view rect inside InputTexture, which can be smaller than the texture itself.
SCREEN_PASS_TEXTURE_VIEWPORT(Input)

float AmbientTemperature;
float TemperatureRangeMin;
float TemperatureRangeMax;
float LuminanceTemperatureGain;
float SkyTemperature;

// Ironbow-style ramp evaluated analytically. Each lerp only starts once the previous segment is saturated.
float3 ThermalPalette(float NormalizedTemperature)
{
    const float3 Cold = float3(0.00, 0.00, 0.05); // near black, slightly blue
    const float3 Purple = float3(0.28, 0.00, 0.42);
    const float3 Red = float3(0.85, 0.15, 0.20);
    const float3 Orange = float3(1.00, 0.60, 0.00);
    const float3 Hot = float3(1.00, 1.00, 0.85); // white hot

    // There are 4 segments, so convert normalized temperature to 0..4
    float Segment = NormalizedTemperature * 4.0;

    float3 Color = lerp(Cold, Purple, saturate(Segment));
    Color = lerp(Color, Red, saturate(Segment - 1.0));
    Color = lerp(Color, Orange, saturate(Segment - 2.0));
    Color = lerp(Color, Hot, saturate(Segment - 3.0));
    return Color;
}

void MainPS(
    noperspective float4 UVAndScreenPos : TEXCOORD0,
    float4 SvPosition : SV_POSITION,
    out float4 OutColor : SV_Target0
)
{
    // Scene Color, tonemapped
    float2 UV = UVAndScreenPos.xy;
    float4 SceneColor = InputTexture.SampleLevel(InputSampler, UV, 0);

    // Resolution mapping
    // 1) Remove the input rect offset and scale: 0..1 across the view, independent of any texture size.
    float2 ViewportUV = (UV - Input_UVViewportMin) * Input_UVViewportSizeInverse;
    // 2) Map 0..1 into the scene textures using the render-resolution rect from the View uniform buffer:
    float2 StencilUV = ViewportUVToBufferUV(ViewportUV);
    
    // Keep the sample inside the view rect: the pooled texture is larger than the view
    float2 ClampedStencilUV = clamp(StencilUV, View.BufferBilinearUVMinMax.xy, View.BufferBilinearUVMinMax.zw);

    // Stencil sample
    // Custom stencil is a uint2 Shader Resource View: integer texel coords, no filtering.
    uint2 ScenePixelPos = (uint2) floor(ClampedStencilUV * View.BufferSizeAndInvSize.xy);
    uint StencilValue = CalcSceneCustomStencil(ScenePixelPos);
    
    // IsSky check
    // DeviceZ is 0 at the far plane with reverse-Z: nothing was rendered, so this pixel is sky.
    float DeviceZ = LookupDeviceZ(ScenePixelPos); // Gets scene depth
    bool bIsSky = DeviceZ <= 0.0;

    // Luminance
    // Tonemapped color is display encoded, so linearize it before measuring luminance.
    float SceneLuminance = Luminance(sRGBToLinear(SceneColor.rgb));

    // Untagged geometry: brighter surfaces read warmer. A heuristic, not radiometry.
    float AmbientSceneTemperature = AmbientTemperature + LuminanceTemperatureGain * SceneLuminance;

    // Check if the object is occluded
    // Compare against scene depth in the same texel: with reverse-Z, nearer is a larger device Z.
    float CustomDeviceZ = SceneTexturesStruct.CustomDepthTexture.Load(int3(ScenePixelPos, 0)).r; // Gets the depth in the custom depth texture (object marked in stencil)
    bool bTagVisible = StencilValue > 0 && CustomDeviceZ >= DeviceZ;
    
    // Initialize temperature with ambient
    float Temperature = AmbientSceneTemperature;

    // If the stencil has a value, update temperature with that value
    if (bTagVisible) Temperature = (float) StencilValue;
    
    // If the pixel is sky, use sky temperature
    if(bIsSky) Temperature = SkyTemperature;

    //Normalize temperature to use the ThermalPalette function
    float NormalizedTemperature = saturate((Temperature - TemperatureRangeMin) / max(TemperatureRangeMax - TemperatureRangeMin, 0.001));

    OutColor = float4(ThermalPalette(NormalizedTemperature), SceneColor.a);
}
